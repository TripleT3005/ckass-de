<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP:Accept-Language} ^(?:\s*(?!(?:en|de)\b)[^,]*,)*\s*de\b [NC]
RewriteRule ^(index\.html)?$ /chat-below-for-twitch/de/ [R=302,L,E=LANGUAGE_REDIRECT:1]
RewriteRule ^(index\.html)?$ /chat-below-for-twitch/en/ [R=302,L,E=LANGUAGE_REDIRECT:1]
</IfModule>
<IfModule mod_headers.c>
Header always merge Vary Accept-Language env=LANGUAGE_REDIRECT
</IfModule>
